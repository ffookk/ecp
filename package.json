{
  "name": "ecp",
  "version": "1.3.2",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run build && npm test",
    "dev": "node scripts/serve.mjs",
    "format": "prettier --write src tests scripts *.html *.json *.md",
    "test:browser": "npm run build && playwright test",
    "privacy:check": "node scripts/privacy-check.mjs",
    "package": "npm run build && node scripts/package.mjs && node scripts/archive.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@noble/post-quantum": "0.7.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/cli": "4.3.3",
    "fake-indexeddb": "6.2.5",
    "prettier": "3.9.8",
    "prettier-plugin-tailwindcss": "0.7.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  }
}
